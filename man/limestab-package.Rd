\name{limestab-package}
\alias{limestab}
\alias{limestab-package}
\docType{package}
\title{limestab: Stable LIME, OptiLIME, BayLIME and ALIME}
\description{Tools for local explanations of tabular black-box models using LIME, OptiLIME, BayLIME and ALIME, together with stability diagnostics for repeated explanations.}
\details{The package provides coefficient, variable-selection, ranking, point-based and interval-based stability measures for repeated local explanations.}
\keyword{package}
